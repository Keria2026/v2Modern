{
  "name": "v2modern-desktop",
  "productName": "V2 Modern",
  "version": "0.1.0",
  "private": true,
  "description": "Liquid Glass inspired Windows client for v2Modern and Xray",
  "author": "v2Modern contributors",
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run setup:electron && npm run build && electron .",
    "build": "tsc -p tsconfig.main.json && vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.tests.json",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/core.integration.ts",
    "build:core": "node scripts/build-core.mjs",
    "dist:win": "npm run build:core && npm run build && electron-builder --win --x64 --publish never",
    "pack:win": "npm run build:core && npm run build && electron-builder --win --x64 --dir --publish never",
    "test:ui": "npm run build && tsx --test tests/ui.integration.ts",
    "test:electron": "npm run setup:electron && npm run build && tsx --test tests/electron.integration.ts",
    "test:xray": "tsx --test tests/xray.integration.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.{ts,cjs}\" \"scripts/*.mjs\" *.json *.mts README.md",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.{ts,cjs}\" \"scripts/*.mjs\" *.json *.mts README.md",
    "setup:electron": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "playwright-core": "1.64.0",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.8.2",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "io.v2modern.desktop",
    "productName": "V2 Modern",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "assets/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "resources/core",
        "to": "core",
        "filter": [
          "*.exe",
          "*.dat"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "toolsets": {
      "wine": "1.0.1"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Keria2026/v2Modern.git"
  }
}
